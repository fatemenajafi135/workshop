# Copy this file to .env and fill in API_KEY (make setup does the copy).
#
# Any OpenAI-compatible provider works. Pick one, uncomment its BASE_URL / MODEL lines.

# --- Vercel AI Gateway: one key, most providers (free $5 credit every 30 days)
BASE_URL=https://ai-gateway.vercel.sh/v1
MODEL=anthropic/claude-haiku-4.5

# --- OpenRouter
# BASE_URL=https://openrouter.ai/api/v1
# MODEL=anthropic/claude-haiku-4.5

# --- OpenAI
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-5-mini

# --- Anthropic
# BASE_URL=https://api.anthropic.com/v1/
# MODEL=claude-haiku-4-5

# --- Google Gemini
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL=gemini-3.1-flash-lite

# --- Ollama, running on your own computer (free, no key needed: use API_KEY=ollama)
# BASE_URL=http://localhost:11434/v1
# MODEL=qwen3-coder

API_KEY=

# Only Vercel reports what each call cost. With another provider, the cost column shows $?
# unless you give the prices in dollars per million tokens (look them up on your provider's pricing page):
# PRICE_IN=1.00
# PRICE_OUT=5.00
