# Copy this file to .env and fill in API_KEY.
#
# Any OpenAI-compatible endpoint works. The default is Vercel AI Gateway,
# which serves models from most providers behind one key.
# Model list: https://vercel.com/ai-gateway/models
BASE_URL=https://ai-gateway.vercel.sh/v1
API_KEY=
MODEL=anthropic/claude-haiku-4.5
